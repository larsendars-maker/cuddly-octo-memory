NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
ADMIN_USERNAME=Larsenda
REQUIRE_EMAIL_VERIFICATION=true
PHOTO_ENCRYPTION_KEY=64-hex-characters
BOOTSTRAP_ADMIN_EMAIL=your-admin-email@example.com
MAX_ACCOUNTS_PER_DEVICE=2
MAIL_PROVIDER=apps-script
MAIL_BRIDGE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
MAIL_BRIDGE_TOKEN=set-in-render-only
MAIL_FROM_NAME=OrbitDesk
GOOGLE_CLIENT_ID=set-in-render-only
GOOGLE_CLIENT_SECRET=set-in-render-only
GOOGLE_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/api/integrations/google/callback
